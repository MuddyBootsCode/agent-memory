# deploy/.env.prod.example
# Copy to deploy/.env and fill in values before deploying

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# BAML entity extraction
NAM_EXTRACTION__BAML_ENABLED=true
NAM_EXTRACTION__BAML_CLIENT=Anthropic
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Verticals & routing
NAM_VERTICALS=meetings,projects,research
NAM_ROUTING_ENABLED=true
NAM_ROUTING_CACHE_ENABLED=true
NAM_ROUTING_CACHE_SIZE=256
NAM_ROUTING_CACHE_TTL=300

# MCP transport
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8080

# Docker management (true when Neo4j is on same host)
NEO4J_DOCKER_AUTO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
